# Simulator REST API base (ListenAddress from settings.json)
SIM_BASE_URL=http://127.0.0.1:9898
SIM_EMAIL=admin
SIM_PASSWORD=admin

# This listener. Put http://<your-lan-ip>:4000/webhook into settings.json -> WebhookUrl
PORT=4000

# observe = log mismatches but always accept (use this first)
# enforce = reject events whose signature fails
SIGNATURE_MODE=observe
# Locked-in algorithm once calibration identifies it, e.g. md5:pipe:alpha
SIGNATURE_RECIPE=

# Billing - VERIFY THESE AGAINST THE SIM BEFORE TRUSTING THEM
RATE_PER_MINUTE=1
ELECTRIC_MULTIPLIER=2
# charge electricity as a separate line for electric cars
ELECTRIC_SPLIT_CHARGING=true

# Entry gate to open when a car arrives (confirm by watching the sim)
DEFAULT_ENTRY_GATE=gateA
DEFAULT_EXIT_GATE=gateB

# Auto-drive the park (false = listener/log only, no commands sent)
AUTOPILOT=false
