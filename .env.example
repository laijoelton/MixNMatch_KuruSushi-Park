# --- Simulator REST API (ListenAddress in settings.json) ---
SIMULATOR_BASE_URL=http://127.0.0.1:9898
SIMULATOR_EMAIL=admin
SIMULATOR_PASSWORD=admin
SIMULATOR_TIMEOUT_S=10

# --- This dispatcher ---
# Put http://<your-lan-ip>:8080/webhooks/simulator into settings.json WebhookUrl
WEBHOOK_PORT=8080
DATABASE_PATH=data/park.db

# false = log intended commands without sending them. Start here.
AUTOPILOT=false

# --- Signature verification ---
# Always enforced: MD5 of values joined by | with alphabetically sorted keys.
# Legacy WEBHOOK_SIGNATURE_MODE/RECIPE/SECRET values are ignored.

# --- Billing (VERIFY AGAINST A REAL CAR BEFORE TRUSTING) ---
PARKING_RATE_PER_MINUTE=1.0
MINIMUM_CHARGE=0.0
ELECTRIC_MULTIPLIER=2.0
ELECTRIC_SPLIT_CHARGING=true

# --- Operations ---
ENTRY_GATE=gateA
CO_FAN_ON_THRESHOLD=50
# Hysteresis: fan switches off once CO drops below this (must be < the ON threshold)
CO_FAN_OFF_THRESHOLD=30

# How long a spot stays promised to a car that has not arrived yet
RESERVATION_TTL_S=120

# Offline dev only: show settings/<level>.json when no level is running.
# Leave empty for real runs so the dashboard stays blank until a level loads
# instead of showing a Level 1 map that is not what the simulator is running.
SEED_FROM_LEVEL=

# Estimate for cars that reach the exit without us seeing them park
UNKNOWN_CAR_MINUTES=3.0

# round | ceil | exact  -- how measured minutes become the billed figure
BILLING_ROUNDING=round

# Exit charge timing - the CarIn sensor fires before the car is settled
EXIT_CHARGE_DELAY_S=2.0
# Charge requests are attempted exactly once, including transport failures.

# Gates start closed. Zone gates open per car and close once it has passed;
# MAIN_GATE is never operated automatically - staff open it from the dashboard.
MAIN_GATE=gate7
# The simulator console, tee'd here by START.bat. Its "Load Game" line tells us a
# level was loaded, so the previous level is cleared and all gates close at once.
SIMULATOR_LOG=data/simulator.log
# true: a car for ZONE2/3 is sent to that zone's entry sensor first, and the zone
# gate opens only when it is waiting there. false: the gate opens at ENTRY1.
ZONE_GATE_AT_SENSOR=true
# Seconds (simulated) after a car leaves the sensor box in front of its zone gate
# before that gate closes behind it (the gate is ~140 px past the sensor).
ENTRY_GATE_CLOSE_DELAY_S=1.5
# Seconds (simulated) after a car leaves the exit sensor before its gate closes.
GATE_CLOSE_DELAY_S=3.0

# Overrides the GameSpeedMultiplier read from the simulator settings.json.
# Our wall-clock waits are divided by this so they stay proportional.
# GAME_SPEED_MULTIPLIER=

# planned | measured  -- the simulator bills the duration the driver booked
BILLING_BASIS=planned

# Dashboard accounts created on first start (change after first sign-in)
DASHBOARD_ADMIN_PASSWORD=admin123
DASHBOARD_OPERATOR_PASSWORD=operator123
DASHBOARD_TECHNICIAN_PASSWORD=technician123
DASHBOARD_AUDITOR_PASSWORD=auditor123

# --- Level 2: multi-zone wear tracking ---
# A component nearing either threshold is proactively queued for repair
# during an idle lull instead of waiting for it to actually break.
# Runtime is simulated seconds (wall-clock runtime x GameSpeedMultiplier).
# Thresholds are configured estimates; validate against the active simulator level.
WEAR_CYCLE_THRESHOLD=500
WEAR_RUNTIME_THRESHOLD_S=36000

# --- Level 2: vehicle-class billing multipliers (on top of the per-minute
# rate; distinct from ELECTRIC_MULTIPLIER, which bills the electricity line) ---
CLASS_MULTIPLIER_SEDAN=1.0
CLASS_MULTIPLIER_SUV=1.25
CLASS_MULTIPLIER_EV=1.1

# --- Level 2: environmental control + reporting ---
# Assumed wattage per light, used only for the reporting estimate.
LIGHT_WATTS_ESTIMATE=60
# How often the environmental-control and wear-check background loops tick.
ENVIRONMENT_LOOP_INTERVAL_S=15
# Hour-of-day (from the simulator's ServerDateTime) lights go OFF for day / ON for night.
DAY_START_HOUR=7
NIGHT_START_HOUR=19

# Physical transit minimum in simulated seconds; exit crossings before this are ignored.
MIN_DWELL_TIME_S=5
# Archive a session that left its bay but never emitted a final exit (simulated seconds).
ORPHAN_TIMEOUT_S=300
# Retry entrance goto every max(0.4, 1/GameSpeedMultiplier) seconds, without blocking webhooks.
ENTRY_MAX_ATTEMPTS=12
# Preventive maintenance begins at 85% of WEAR_* rated thresholds.
# Tariff values above seed SQLite once; subsequent edits use /tariffs.
