# --- Simulator REST API (ListenAddress in settings.json) ---
SIMULATOR_BASE_URL=http://127.0.0.1:9898
SIMULATOR_EMAIL=admin
SIMULATOR_PASSWORD=admin
SIMULATOR_TIMEOUT_S=10

# --- This dispatcher ---
# Put http://<your-lan-ip>:8080/webhooks/simulator into settings.json WebhookUrl
WEBHOOK_PORT=8080
DATABASE_PATH=data/park.db

# false = log intended commands without sending them. Start here.
AUTOPILOT=false

# --- Signature verification ---
# observe = calibrate against live traffic, never reject (start here)
# enforce = require a match
WEBHOOK_SIGNATURE_MODE=observe
# Pin once `python -m scripts.signature_report` shows a 100% recipe
WEBHOOK_SIGNATURE_RECIPE=
# Only if the organisers confirm a shared secret (HMAC instead of plain hash)
WEBHOOK_SECRET=

# --- Billing (VERIFY AGAINST A REAL CAR BEFORE TRUSTING) ---
PARKING_RATE_PER_MINUTE=1.0
MINIMUM_CHARGE=0.0
ELECTRIC_MULTIPLIER=2.0
ELECTRIC_SPLIT_CHARGING=true

# --- Operations ---
ENTRY_GATE=gateA
CO_FAN_ON_THRESHOLD=50

# How long a spot stays promised to a car that has not arrived yet
RESERVATION_TTL_S=120

# Offline dev: load park layout from settings/<level>.json if the sim is down
SEED_FROM_LEVEL=lvl1

# Estimate for cars that reach the exit without us seeing them park
UNKNOWN_CAR_MINUTES=3.0

# round | ceil | exact  -- how measured minutes become the billed figure
BILLING_ROUNDING=round

# Exit charge timing - the CarIn sensor fires before the car is settled
EXIT_CHARGE_DELAY_S=2.0
PAYMENT_WAIT_S=25
CHARGE_MAX_ATTEMPTS=3

# Overrides the GameSpeedMultiplier read from the simulator settings.json.
# Our wall-clock waits are divided by this so they stay proportional.
# GAME_SPEED_MULTIPLIER=
